<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ZavaLoanPortal.SiteMaster" %>
<!DOCTYPE html><html><head runat="server"><title>Zava Loan Portal</title><style>body{margin:0;background:#cfd7e2;font-family:Verdana,Arial;font-size:12px;}a{color:#103d73;text-decoration:none;}a:hover{text-decoration:underline;}</style></head><body><form id="form1" runat="server"><asp:ScriptManager ID="smMain" runat="server" /><table width="100%" cellpadding="0" cellspacing="0"><tr><td style="height:72px;background:#1e4f8a;color:#fff;padding-left:18px;background-image:linear-gradient(#3a6ea8,#1e4f8a);"><span style="font-size:24px;font-weight:bold;">Zava Loan Portal</span><br /><span style="font-size:11px;">Legacy Loan Origination Front Office</span></td></tr><tr><td style="background:#b8c6d8;border-top:1px solid #8ea7c2;border-bottom:1px solid #8ea7c2;padding:6px 10px;"><a href="/" style="font-weight:bold;color:#1e4f8a;">&#9664; ZavaBank Portal</a>&nbsp;|&nbsp;<asp:HyperLink ID="lnkHome" runat="server" NavigateUrl="~/Default.aspx" Text="Home" />&nbsp;|&nbsp;<asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx" Text="Login" />&nbsp;|&nbsp;<asp:HyperLink ID="lnkLogout" runat="server" NavigateUrl="~/Logout.aspx" Text="Logout" /><span style="float:right;"><asp:Label ID="lblUserStatus" runat="server" /></span></td></tr><tr><td><asp:ContentPlaceHolder ID="MainContentPlaceHolder" runat="server" /></td></tr></table></form></body></html>
