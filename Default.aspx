<%@ Page Title="Loan Application Wizard" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Default.aspx.cs" Inherits="ZavaLoanPortal.Default" %><asp:Content ID="MainContent" ContentPlaceHolderID="MainContentPlaceHolder" runat="server"><table width="100%" cellpadding="0" cellspacing="0"><tr><td style="padding:12px;"><asp:UpdatePanel ID="updLoanWizard" runat="server"><ContentTemplate><table width="100%" cellpadding="4" cellspacing="0" style="border:1px solid #8ea7c2;background:#f7f9fc;"><tr><td style="font-size:16px;font-weight:bold;background:#d1d9e5;color:#1f3f68;">New Loan Application</td></tr><tr><td><asp:Wizard ID="wizLoanApplication" runat="server" DisplaySideBar="false" Width="100%" OnActiveStepChanged="wizLoanApplication_ActiveStepChanged" OnNextButtonClick="wizLoanApplication_NextButtonClick" OnFinishButtonClick="wizLoanApplication_FinishButtonClick"><WizardSteps><asp:WizardStep ID="s1" runat="server" Title="Personal Info"><table><tr><td>Customer ID:</td><td><asp:TextBox ID="txtCustomerId" runat="server" /></td></tr><tr><td>First Name:</td><td><asp:TextBox ID="txtFirstName" runat="server" /></td></tr><tr><td>Last Name:</td><td><asp:TextBox ID="txtLastName" runat="server" /></td></tr><tr><td>Email:</td><td><asp:TextBox ID="txtEmail" runat="server" Width="260" /></td></tr></table></asp:WizardStep><asp:WizardStep ID="s2" runat="server" Title="Employment"><table><tr><td>Employer:</td><td><asp:TextBox ID="txtEmployer" runat="server" Width="220" /></td></tr><tr><td>Job Title:</td><td><asp:TextBox ID="txtJobTitle" runat="server" Width="220" /></td></tr><tr><td>Years:</td><td><asp:TextBox ID="txtYearsEmployed" runat="server" Width="80" /></td></tr><tr><td>Income:</td><td><asp:TextBox ID="txtAnnualIncome" runat="server" Width="120" /></td></tr></table></asp:WizardStep><asp:WizardStep ID="s3" runat="server" Title="Loan Details"><table><tr><td>Loan Product:</td><td><asp:DropDownList ID="ddlLoanProduct" runat="server" /></td></tr><tr><td>Amount:</td><td><asp:TextBox ID="txtRequestedAmount" runat="server" /></td></tr><tr><td>Term Months:</td><td><asp:TextBox ID="txtTermMonths" runat="server" /></td></tr><tr><td>Purpose:</td><td><asp:TextBox ID="txtPurpose" runat="server" TextMode="MultiLine" Rows="3" Width="280" /></td></tr></table></asp:WizardStep><asp:WizardStep ID="s4" runat="server" Title="Review"><asp:Label ID="lblReviewSummary" runat="server" /></asp:WizardStep><asp:WizardStep ID="s5" runat="server" Title="Submit"><asp:Label ID="lblSubmitStepMessage" runat="server" Text="Click Finish to submit." /></asp:WizardStep></WizardSteps></asp:Wizard><br /><asp:Label ID="lblSubmissionStatus" runat="server" Font-Bold="true" ForeColor="#003366" /></td></tr></table><br /><table width="100%" cellpadding="4" cellspacing="0" style="border:1px solid #8ea7c2;background:#f7f9fc;"><tr><td style="font-size:16px;font-weight:bold;background:#d1d9e5;color:#1f3f68;">Loan Application History</td></tr><tr><td><asp:GridView ID="gvLoanHistory" runat="server" Width="100%" AutoGenerateColumns="true" DataKeyNames="ApplicationID" OnRowCommand="gvLoanHistory_RowCommand"><Columns><asp:ButtonField Text="Review" CommandName="ReviewApplication" /></Columns></asp:GridView></td></tr></table></ContentTemplate></asp:UpdatePanel></td></tr></table></asp:Content>
